{
  "name": "my-agenda",
  "version": "0.4.0",
  "description": "Local reimplementation: Week/Month agenda views with draggable timelines, click-to-create tasks inline, reading timed checkbox tasks from daily notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs",
    "build:prod": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "author": "Soren",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.5.7",
    "typescript": "^5.4.0"
  }
}
